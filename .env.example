# Cole aqui a connection string do Supabase (Connect > ORMs > Prisma).
# Para migrations, prefira a conexão direta com sslmode=require.
# Pooler Supavisor para a aplicação (porta 6543).
DATABASE_URL="postgresql://postgres.PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&schema=public"
# Conexão direta para prisma migrate (porta 5432).
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.PROJETO.supabase.co:5432/postgres?sslmode=require&schema=public"
PORT=3333
FRONTEND_URL=http://localhost:5173
TOKEN_SECRET=replace-with-a-long-random-secret
